{
  "name": "react-native-expo-template",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "cross-env APP_ENV=development expo start",
    "start:preview": "cross-env APP_ENV=preview expo start",
    "start:production": "cross-env APP_ENV=production expo start",
    "android": "cross-env APP_ENV=development expo run:android",
    "ios": "cross-env APP_ENV=development expo run:ios",
    "android:preview": "cross-env APP_ENV=preview expo run:android",
    "ios:preview": "cross-env APP_ENV=preview expo run:ios",
    "prebuild": "cross-env APP_ENV=development STRICT_ENV_VALIDATION=1 expo prebuild --clean",
    "prebuild:preview": "cross-env APP_ENV=preview STRICT_ENV_VALIDATION=1 expo prebuild --clean",
    "prebuild:production": "cross-env APP_ENV=production STRICT_ENV_VALIDATION=1 expo prebuild --clean",
    "build:development:android": "eas build --profile development --platform android",
    "build:development:ios": "eas build --profile development --platform ios",
    "build:preview:android": "eas build --profile preview --platform android",
    "build:preview:ios": "eas build --profile preview --platform ios",
    "build:production:android": "eas build --profile production --platform android",
    "build:production:ios": "eas build --profile production --platform ios",
    "icons:badge": "node scripts/generate-badged-icons.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "check-all": "pnpm lint && pnpm type-check",
    "doctor": "expo-doctor",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "expo": "~58.0.14",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.14",
    "expo-font": "~58.0.8",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.15",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.23",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.17",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint-react/eslint-plugin": "^5.28.0",
    "@types/react": "~19.3.0",
    "app-icon-badge": "^0.1.2",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.8",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "expo-doctor": "^1.21.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
